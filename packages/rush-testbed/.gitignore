# generated by rush inside the fixture — never committed
fixture/common/temp/
fixture/common/deploy/
fixture/common/deploy-*/
fixture/common/autoinstallers/*/node_modules/
fixture/projects/*/.rush/
fixture/projects/*/node_modules/
# harness scratch output
tmp/
# fallow incremental cache — created by scans, never committed
.fallow/
**/.fallow/
# autoinstaller lockfile references freshly-packed tarballs (integrity churns per pack)
fixture/common/autoinstallers/rush-plugins/pnpm-lock.yaml
fixture/common/autoinstallers/*/.npmrc
# rush-generated autoinstaller state (install flags + the plugin store rush update populates)
fixture/common/autoinstallers/*/.rush/
fixture/common/autoinstallers/*/rush-plugins/
