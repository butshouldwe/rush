{
  "name": "@butshouldwe/worktree-rush",
  "version": "0.1.0",
  "description": "Rush plugin for fast, fully inherited git worktrees with creation, bootstrap, and proof-bearing cleanup commands.",
  "keywords": [
    "agents",
    "monorepo",
    "rush",
    "rush-plugin",
    "worktree"
  ],
  "homepage": "https://github.com/butshouldwe/rush/tree/main/packages/worktree-rush#readme",
  "bugs": {
    "url": "https://github.com/butshouldwe/rush/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/butshouldwe/rush.git",
    "directory": "packages/worktree-rush"
  },
  "bin": {
    "worktree-rush": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "rush-plugin-manifest.json",
    "command-line.json",
    "WORKTREE-INHERITANCE.md",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "_phase:build": "tsdown",
    "_phase:typecheck": "tsc --noEmit",
    "_phase:lint": "oxlint .",
    "_phase:test": "vitest run",
    "_phase:publish-check": "publint --pack npm --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "22.20.1",
    "oxlint": "1.74.0",
    "publint": "0.3.22",
    "tsdown": "0.22.9",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
